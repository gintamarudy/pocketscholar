# PocketScholar — Firebase web config (public client config, NOT a secret).
# Copy this file to `.env` and fill in the values from your Firebase project:
# Firebase console > Project settings > Your apps > Web app > firebaseConfig.
# The app runs fully local-only until all six values are set.
# NEVER put API keys, service-account keys, or any server secret in this repo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA v3 site key for App Check in production builds.
# Local dev uses the App Check debug provider instead (see SETUP.md).
VITE_RECAPTCHA_SITE_KEY=
