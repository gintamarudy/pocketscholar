rules_version = '2';

// PocketScholar (M1): no user accounts yet. Notes sync under a per-browser
// device id so each browser only touches its own documents:
//   /devices/{deviceId}/notes/{noteId}
// This is a pragmatic M1 rule for a single-device demo app; before a public
// launch, replace it with Firebase Auth + per-user rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /devices/{deviceId}/notes/{noteId} {
      allow read, write: if request.auth == null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
